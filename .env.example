# Supabase Credentials
# Copy SUPABASE_URL here:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Copy SUPABASE_PUBLISHABLE_KEY here (also known as anon key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Copy SUPABASE_SECRET_KEY here (also known as service_role key - keep private!):
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Note: SUPABASE_JWKS_URL is NOT needed for this setup.

# Google Gemini AI API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Google OAuth 2.0 Credentials (for Google Drive integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-google-picker-api-key

# Resend Email API Key (for email reminders)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@projecthub.dev

# Next.js App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
